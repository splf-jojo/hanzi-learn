# Подключение к Postgres (база создаётся заранее: createdb hanzi)
DATABASE_URL=postgresql+psycopg://postgres:123@localhost:5432/hanzi

# OCR: true требует установленных requirements-ml.txt (PaddleOCR)
USE_PADDLEOCR=true

# Тестовая БД (pytest); по умолчанию hanzi_test на том же сервере
# TEST_DATABASE_URL=postgresql+psycopg://postgres:123@localhost:5432/hanzi_test

# CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# LOG_LEVEL=INFO
# MAX_IMAGE_MB=10
# CLIP_MODEL_NAME=ViT-B-32
# CLIP_PRETRAINED=laion2b_s34b_b79k
# CLIP_DEVICE=cpu
